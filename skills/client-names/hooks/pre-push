#!/usr/bin/env bash
# Refuse to push a client's names to a remote that is not allowed to hold them,
# then run the repository's own pre-push hook, if it has one.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
refs="$(cat)"
printf '%s\n' "$refs" | python3 "$here/../scripts/client_names.py" scan-push "$1" "$2"
own="$(git rev-parse --git-common-dir)/hooks/pre-push"
if [[ -x "$own" ]]; then
  printf '%s\n' "$refs" | "$own" "$@"
fi
